---
import Default from "../../layout/default.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Default title="Blog">
	<div class="blog">
		<h1>Blog</h1>
		<ul class="blog__list">
			{
				posts.map((post) => (
					<li class="blog__item">
						<a href={`/blog/${post.id}/`}>
							<span class="blog__item-title">{post.data.title}</span>
							<span class="blog__item-date">
								{post.data.date.toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
									timeZone: "UTC",
								})}
							</span>
						</a>
						{post.data.description && <p class="blog__item-description">{post.data.description}</p>}
					</li>
				))
			}
		</ul>
	</div>
</Default>

<style>
	.blog {
		max-width: 42rem;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.blog__list {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}

	.blog__item {
		padding: 1.25rem 0;
		border-bottom: 1px solid #e2e2e2;
	}

	.blog__item a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		color: inherit;
		text-decoration: none;
	}

	.blog__item a:hover .blog__item-title {
		text-decoration: underline;
	}

	.blog__item-title {
		font-weight: 700;
		font-size: 1.05rem;
	}

	.blog__item-date {
		flex-shrink: 0;
		color: #555;
		font-size: 0.875rem;
	}

	.blog__item-description {
		margin: 0.375rem 0 0;
		color: #555;
	}
</style>
