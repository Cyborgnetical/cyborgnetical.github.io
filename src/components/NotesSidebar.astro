---
import type { NoteTreeNode } from "../lib/buildNotesTree";

interface Props {
	tree: NoteTreeNode[];
	activeSlug?: string;
}

const { tree, activeSlug } = Astro.props;
---

<ul class="notes-tree">
	{
		tree.map((node) =>
			node.type === "folder" ? (
				<li class="notes-tree__folder">
					<span class="notes-tree__folder-label">{node.name}</span>
					<Astro.self tree={node.children} activeSlug={activeSlug} />
				</li>
			) : (
				<li class="notes-tree__file">
					<a href={`/notes/${node.slug}/`} aria-current={activeSlug === node.slug ? "page" : undefined}>
						{node.title}
					</a>
				</li>
			),
		)
	}
</ul>

<style>
	.notes-tree {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.notes-tree .notes-tree {
		margin-top: 0.375rem;
		margin-left: 0.75rem;
		padding-left: 0.75rem;
		border-left: 1px solid #e2e2e2;
	}

	.notes-tree__folder {
		margin-bottom: 0.75rem;
	}

	.notes-tree__folder-label {
		display: block;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: #888;
	}

	.notes-tree__file {
		margin: 0.25rem 0;
	}

	.notes-tree__file a {
		display: block;
		color: inherit;
		text-decoration: none;
		font-size: 0.95rem;
		padding: 0.15rem 0;
	}

	.notes-tree__file a:hover {
		text-decoration: underline;
	}

	.notes-tree__file a[aria-current="page"] {
		font-weight: 700;
		color: #0b0c10;
	}
</style>
