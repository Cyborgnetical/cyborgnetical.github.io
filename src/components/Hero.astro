---
const links = [
	{ label: "Notes", href: "/notes" },
	{ label: "Blog", href: "/blog" },
	{ label: "Projects", href: "/projects" },
	{ label: "About Me", href: "/about" },
];

const quotes = [
	"Insanity Engineered",
	"Nothing that enough caffine can fix",
	"FREEDOM",
	"I am a dissident of managed democracy",
	"Merp",
	"Im Lazy",
	"bwaaaaaaaaaaa",
	`${Math.ceil(Math.random()*4)} cup(s) of coffee and ${Math.ceil(Math.random()*10)} page(s) later...`,
	"RAHHHHHHHHHHHHHHH",
	"Agnes Tachyon is the best Umamusume",
	"Mambo","The Indomitable Human Spirit vs The Universe",
	"Don't worry, the expriment won't hurt :)",
	"Hey look im alive","DEMOCRACYYYYYYYYYYYY!!!!!!!!!1",
	"I am borg, the lazy.",
	"Im tired",
	"Got a monster?",
	"Umamazing 👍",
	"Walking talking like you know I want your pretty litte PSYCHO!!!!!!!!!!",
	"Nightcoreeeee",
	"Mi hijo, porque?",
	"Primo Victoria ( Sabaton )",
	"Burnt out genius."
];

const quote = quotes[Math.floor(Math.random() * quotes.length)];
---

<section class="hero">
	<div class="hero__image">
		<img
			src="/images/iss.jpg"
			alt="The International Space Station photographed against Earth"
			width="3319"
			height="2116"
		/>
	</div>
	<div class="hero__content">
		<h1><span>Cyborgnetical</span> | Hobbyist</h1>
		<p class="hero__quote">── "{quote}"</p>
		<div class="hero__links">
			{
				links.map((link) => (
					<a class="hero__button" href={link.href}>
						{link.label}
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: 80vh;
	}

	.hero__image {
		position: relative;
		overflow: hidden;
	}

	.hero__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 1.25rem;
		padding: 3rem 4rem;
		background: #0b0c10;
		color: #f5f5f5;
	}

	.hero__content h1 {
		font-size: clamp(1.75rem, 3vw, 2.75rem);
		font-weight: 700;
		margin: 0;
		line-height: 1.2;
	}

	.hero__content h1 span {
		color: #7dd3fc;
	}

	.hero__quote {
		font-size: 1rem;
		font-style: italic;
		color: #a1a1aa;
		margin: 0;
	}

	.hero__links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.hero__button {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border: 1px solid #f5f5f5;
		border-radius: 0.375rem;
		color: inherit;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 600;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.hero__button:hover {
		background: #f5f5f5;
		color: #0b0c10;
	}

	@media (max-width: 48rem) {
		.hero {
			grid-template-columns: 1fr;
		}

		.hero__image {
			min-height: 16rem;
		}

		.hero__content {
			padding: 2.5rem 1.5rem;
		}
	}
</style>
