---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<p>&copy; {year} Cyborgnetical. All rights reserved.</p>
		<ul class="site-footer__links">
			<li><a href="https://github.com/cyborgnetical" target="_blank" rel="noopener noreferrer">GitHub</a></li>
			<li><a href="mailto:cyborgnetical@gmail.com">Email</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid #e2e2e2;
		margin-top: 3rem;
	}

	.site-footer__inner {
		max-width: 60rem;
		margin: 0 auto;
		padding: 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.875rem;
		color: #555;
	}

	.site-footer__inner p {
		margin: 0;
	}

	.site-footer__links {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-footer__links a {
		color: inherit;
		text-decoration: none;
	}

	.site-footer__links a:hover {
		text-decoration: underline;
	}
</style>
